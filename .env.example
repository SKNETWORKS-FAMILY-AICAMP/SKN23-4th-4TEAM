OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_HTTPONLY=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

DB_ENGINE=postgres
POSTGRES_DB=youonlytalkonce
POSTGRES_USER=youonlytalkonce
POSTGRES_PASSWORD=youonlytalkonce
POSTGRES_HOST=db
POSTGRES_PORT=5432

FASTAPI_BASE_URL=http://fastapi:8001
FASTAPI_TIMEOUT_SECONDS=10
